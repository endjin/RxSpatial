<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MapRunRxSpatial</RootNamespace>
    <AssemblyName>MapRunRxSpatial</AssemblyName>
    <!-- Dynamic PGO instruments hot methods and keeps their profiles and an extra tier of
         code: ~4 MB of code and loader heap (CLR total 39.7 -> 35.6 MB on the Overlap tab)
         with no measurable effect on tick, send or UI-thread time in this demo. -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RxSpatial\RxSpatial.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="trafficData\**" CopyToOutputDirectory="PreserveNewest" />
    <None Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
