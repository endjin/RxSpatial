<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <!-- Microsoft.SqlServer.Types needs its Windows-only native library at runtime. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>RxSpatial.SqlServer.Tests</RootNamespace>
    <AssemblyName>RxSpatial.SqlServer.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- GoldenCases places its inputs with GeographicLib; test-only, never a runtime dependency. -->
    <PackageReference Include="GeographicLib.NET" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.SqlServer.Types" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RxSpatial\RxSpatial.csproj" />
    <ProjectReference Include="..\RxSpatial.SqlServer\RxSpatial.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The golden file model and case list are shared with the cross-platform tests, which
         read the files this project records (Golden/GoldenValueRecorder.cs) and guards. -->
    <Compile Include="..\RxSpatial.Tests\Golden\GoldenFile.cs" Link="Golden\GoldenFile.cs" />
    <Compile Include="..\RxSpatial.Tests\Golden\GoldenCases.cs" Link="Golden\GoldenCases.cs" />
    <None Include="..\RxSpatial.Tests\Golden\*.json" Link="golden\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
