<Window x:Class="MapRunRxSpatial.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:rx="clr-namespace:RxSpatial;assembly=RxSpatial"
        Title="MapRun RxSpatial" Height="880" Width="1300" MinHeight="600" MinWidth="900"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" KeyDown="OnWindowKeyDown" StateChanged="OnStateChanged">
    <!-- The Fluent theme (App.xaml ThemeMode) supplies the control styles and the theme brushes
         used below, which are DynamicResource so they follow the theme dictionary. Shared
         styles come first: a missing StaticResource key fails when the window is created, not
         at build time. -->
    <Window.Resources>
        <!-- Surfaces -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14,16,16"/>
        </Style>

        <!-- Typography: section title > field label and value > secondary text > ticks.
             Contrast floor is WCAG 2.2 AA (4.5:1): text never uses TextFillColorTertiaryBrush
             (3.3:1), and AccessibleTheme makes the secondary brush opaque (WPF renders
             translucent text lighter than its composited colour). Ticks are secondary text,
             set apart by size alone. -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- A section after the first: its title row is spaced from the controls above. -->
        <Style x:Key="SectionHeader" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,20,0,8"/>
            <Setter Property="LastChildFill" Value="True"/>
        </Style>
        <Style x:Key="FirstSectionHeader" TargetType="DockPanel" BasedOn="{StaticResource SectionHeader}">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="FieldHeader" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="Tick" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- Tick labels under a slider, tucked up to its track. -->
        <Style x:Key="TickRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,-2,0,0"/>
        </Style>
        <!-- Only the end ticks: the right one must not fill the row. -->
        <Style x:Key="TickRowEnds" TargetType="DockPanel" BasedOn="{StaticResource TickRow}">
            <Setter Property="LastChildFill" Value="False"/>
        </Style>
        <Style x:Key="TickLeft" TargetType="TextBlock" BasedOn="{StaticResource Tick}">
            <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>
        <Style x:Key="TickRight" TargetType="TextBlock" BasedOn="{StaticResource Tick}">
            <Setter Property="DockPanel.Dock" Value="Right"/>
        </Style>
        <Style x:Key="TickCentre" TargetType="TextBlock" BasedOn="{StaticResource Tick}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>

        <!-- Every slider here selects an integer, so values snap to whole numbers. -->
        <Style x:Key="DemoSlider" TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Buttons share a one-row UniformGrid, so they are equally wide; the grid's negative
             margin cancels the outer half of the 8px gutter. -->
        <Style x:Key="ButtonRow" TargetType="UniformGrid">
            <Setter Property="Rows" Value="1"/>
            <Setter Property="Margin" Value="-4,16,-4,0"/>
        </Style>
        <Style x:Key="DemoButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <!-- Clear areas / Clear pairs, at the right of their section's title. -->
        <Style x:Key="SectionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="DockPanel.Dock" Value="Right"/>
            <Setter Property="Padding" Value="10,3,10,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <!-- An area button stays pressed (accent fill) while the map is in drawing mode for it. -->
        <Style x:Key="DrawAreaButton" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <!-- Spatial index: a segmented control, one RadioButton per segment. The selected
             segment is raised (control fill and elevation border) with an accent pill. -->
        <Style x:Key="SegmentedTrack" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="4" Padding="4,5,4,7">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle x:Name="Pill" Width="14" Height="3" RadiusX="1.5" RadiusY="1.5"
                                           VerticalAlignment="Bottom" Margin="0,0,0,-6"
                                           Fill="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Scenario tabs: a compact selector bar (text tabs with an accent underline pill)
             whose five headers fit one row at the panel width (13px text, 6px side padding). -->
        <Style x:Key="ScenarioTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <!-- Local: the header row's TabIndex orders it before the content, and only within the tabs. -->
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1"
                                    Padding="4,4,4,0">
                                <!-- One tab stop (the selected tab), arrows between tabs, as in the
                                     stock TabPanel. Without it Tab walks every header, and focusing
                                     a header selects it, so tabbing through reset each scenario. -->
                                <StackPanel Orientation="Horizontal" IsItemsHost="True" KeyboardNavigation.TabIndex="1"
                                            KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                            </Border>
                            <!-- The part name matters: UI Automation reaches the tab content through it. -->
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="4" Margin="0,4,0,6" Background="Transparent"/>
                            <ContentPresenter ContentSource="Header" Margin="6,10,6,13" RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"/>
                            <Rectangle x:Name="Indicator" Width="16" Height="3" RadiusX="1.5" RadiusY="1.5"
                                       VerticalAlignment="Bottom" Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                       Visibility="Hidden"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Guidance -->
        <Style x:Key="GuidanceTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <!-- The query the tab demonstrates, as a code tag under the title. -->
        <Style x:Key="QueryTag" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,1,6,2"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="QueryTagText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="QueryTagRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,6,0,14"/>
        </Style>
        <Style x:Key="GuidanceText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="LineHeight" Value="19"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="GuidanceParagraph" TargetType="TextBlock" BasedOn="{StaticResource GuidanceText}">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="GuidanceNote" TargetType="TextBlock" BasedOn="{StaticResource GuidanceParagraph}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- The colour names that key a legend row, and query names in running text. -->
        <Style x:Key="Term" TargetType="Run">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="GuidanceSection" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
            <Setter Property="Margin" Value="0,6,0,8"/>
        </Style>

        <!-- Numbered steps: an accent badge beside the step text. -->
        <Style x:Key="Step" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="StepNumber" TargetType="ContentControl">
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.FontSize="11" TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Legend rows: a fixed swatch column, centred on the first text line. -->
        <Style x:Key="LegendRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="LegendSwatch" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="LegendSwatchWide" TargetType="StackPanel" BasedOn="{StaticResource LegendSwatch}">
            <Setter Property="Width" Value="44"/>
        </Style>
        <!-- Legend swatches matching the map's area styles (AREA_STYLES in wwwroot/map.html):
             restricted is a slate diagonal hatch with a solid outline, confinement a purple
             dashed outline over an almost clear fill. -->
        <LinearGradientBrush x:Key="RestrictedHatch" MappingMode="Absolute" SpreadMethod="Repeat"
                             StartPoint="0,0" EndPoint="2.5,2.5">
            <GradientStop Color="#9937474F" Offset="0"/>
            <GradientStop Color="#9937474F" Offset="0.45"/>
            <GradientStop Color="Transparent" Offset="0.45"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="AreaSwatch" TargetType="Rectangle">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="RadiusX" Value="2"/>
            <Setter Property="RadiusY" Value="2"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="RestrictedSwatch" TargetType="Rectangle" BasedOn="{StaticResource AreaSwatch}">
            <Setter Property="Fill" Value="{StaticResource RestrictedHatch}"/>
            <Setter Property="Stroke" Value="#37474F"/>
        </Style>
        <Style x:Key="ConfinementSwatch" TargetType="Rectangle" BasedOn="{StaticResource AreaSwatch}">
            <Setter Property="Fill" Value="#0F6A1B9A"/>
            <Setter Property="Stroke" Value="#6A1B9A"/>
            <Setter Property="StrokeDashArray" Value="2 1"/>
            <Setter Property="RadiusX" Value="0"/>
            <Setter Property="RadiusY" Value="0"/>
        </Style>
        <!-- Vehicle marker swatches: the map's fill colour and shape with a hairline ring, so
             light fills (yellow) stay crisp on the card. Every state has its own shape
             (VehicleColors), so colour is never the only cue: blue circle, gray dashed ring,
             green rounded square, yellow triangle, red diamond. Each legend row names both. -->
        <Style x:Key="LegendDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Stroke" Value="#40000000"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3,0,0,0"/>
        </Style>
        <Style x:Key="LegendDashedDot" TargetType="Ellipse" BasedOn="{StaticResource LegendDot}">
            <Setter Property="Fill" Value="#757575"/>
            <Setter Property="Width" Value="13"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="StrokeDashArray" Value="1.2 1"/>
        </Style>
        <Style x:Key="LegendSquare" TargetType="Rectangle">
            <Setter Property="Width" Value="11"/>
            <Setter Property="Height" Value="11"/>
            <Setter Property="Fill" Value="#2E7D32"/>
            <Setter Property="Stroke" Value="#40000000"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="RadiusX" Value="2.5"/>
            <Setter Property="RadiusY" Value="2.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3.5,0,0,0"/>
        </Style>
        <!-- The warning triangle keeps the map marker's dark border. -->
        <Style x:Key="LegendTriangle" TargetType="Path">
            <Setter Property="Data" Value="M 7,0.75 L 13.25,12 L 0.75,12 Z"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="13"/>
            <Setter Property="Fill" Value="#FFD54F"/>
            <Setter Property="Stroke" Value="#333333"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
        </Style>
        <Style x:Key="LegendDiamond" TargetType="Rectangle">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Fill" Value="#D32F2F"/>
            <Setter Property="Stroke" Value="#40000000"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="RadiusX" Value="1"/>
            <Setter Property="RadiusY" Value="1"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="45"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LegendLine" TargetType="Line">
            <Setter Property="X1" Value="0"/>
            <Setter Property="X2" Value="22"/>
            <Setter Property="Y1" Value="9.5"/>
            <Setter Property="Y2" Value="9.5"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>

        <!-- Overlap swatches, matching the map (OVERLAY_STYLES and AREA_STYLES.zone in
             wwwroot/map.html): a thin slate reach circle, a teal dotted lens with a solid
             outline, a brown zone outline, and a brown back-hatch for a reach inside a zone.
             Each has its own pattern or outline, so none relies on colour alone. -->
        <DrawingBrush x:Key="LensDots" TileMode="Tile" Viewport="0,0,3,3" ViewportUnits="Absolute"
                      Viewbox="0,0,3,3" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <!-- The map's light teal tint under the dots. -->
                    <GeometryDrawing Brush="#1F00695C">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,3,3"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#00695C">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="1.5,1.5" RadiusX="0.75" RadiusY="0.75"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <LinearGradientBrush x:Key="ZoneOverlapHatch" MappingMode="Absolute" SpreadMethod="Repeat"
                             StartPoint="2.5,0" EndPoint="0,2.5">
            <GradientStop Color="#B36D4C41" Offset="0"/>
            <GradientStop Color="#B36D4C41" Offset="0.45"/>
            <GradientStop Color="Transparent" Offset="0.45"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ReachSwatch" TargetType="Ellipse">
            <Setter Property="Width" Value="17"/>
            <Setter Property="Height" Value="17"/>
            <Setter Property="Stroke" Value="#455A64"/>
            <Setter Property="StrokeThickness" Value="1.25"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="LensSwatch" TargetType="Path">
            <!-- Two circular arcs: the lens two overlapping circles make. -->
            <Setter Property="Data" Value="M 1,7 A 9,9 0 0 1 17,7 A 9,9 0 0 1 1,7 Z"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Fill"/>
            <Setter Property="Fill" Value="{StaticResource LensDots}"/>
            <Setter Property="Stroke" Value="#00695C"/>
            <Setter Property="StrokeThickness" Value="1.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ZoneSwatch" TargetType="Rectangle" BasedOn="{StaticResource AreaSwatch}">
            <Setter Property="Fill" Value="#106D4C41"/>
            <Setter Property="Stroke" Value="#6D4C41"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="RadiusX" Value="0"/>
            <Setter Property="RadiusY" Value="0"/>
        </Style>
        <Style x:Key="ZoneOverlapSwatch" TargetType="Rectangle" BasedOn="{StaticResource AreaSwatch}">
            <Setter Property="Fill" Value="{StaticResource ZoneOverlapHatch}"/>
            <Setter Property="Stroke" Value="#6D4C41"/>
            <Setter Property="StrokeThickness" Value="1"/>
            <Setter Property="RadiusX" Value="6.5"/>
            <Setter Property="RadiusY" Value="6.5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- WebView2 is an HWND-hosted control that always renders above WPF content,
                 so the control panel sits beside the map instead of overlaying it. -->
            <ColumnDefinition Width="376"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <wv2:WebView2 x:Name="mapView" Grid.Column="1"/>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Keep the tab order: OnScenarioTabChanged maps tabs to scenarios by index. -->
            <TabControl Grid.Row="0" Style="{StaticResource ScenarioTabs}" SelectionChanged="OnScenarioTabChanged">
                <TabItem Header="Geofence">
                    <Border Style="{StaticResource Card}" Margin="12,12,12,0">
                        <StackPanel>
                            <DockPanel Style="{StaticResource FirstSectionHeader}">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="Traffic"/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource FieldHeader}" Margin="0">
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Value, ElementName=VehicleCountSlider, StringFormat='{}{0:0}'}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Vehicles"/>
                            </DockPanel>
                            <Slider x:Name="VehicleCountSlider" AutomationProperties.Name="Vehicles" Style="{StaticResource DemoSlider}"
                                    Minimum="1" Maximum="20" ValueChanged="OnVehicleCountChanged"/>
                            <DockPanel Style="{StaticResource TickRow}">
                                <TextBlock Style="{StaticResource TickLeft}" Text="1"/>
                                <TextBlock Style="{StaticResource TickRight}" Text="20"/>
                                <TextBlock Style="{StaticResource TickCentre}" Text="10"/>
                            </DockPanel>

                            <DockPanel Style="{StaticResource FieldHeader}">
                                <TextBlock Style="{StaticResource FieldValue}" Text="{Binding Value, ElementName=VehicleSpeedSlider, StringFormat='{}{0:0} updates/s'}"/>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Replay rate"/>
                            </DockPanel>
                            <Slider x:Name="VehicleSpeedSlider" AutomationProperties.Name="Replay rate" Style="{StaticResource DemoSlider}"
                                    Minimum="1" Maximum="50" ValueChanged="OnVehicleSpeedChanged"/>
                            <DockPanel Style="{StaticResource TickRow}">
                                <TextBlock Style="{StaticResource TickLeft}" Text="1"/>
                                <TextBlock Style="{StaticResource TickRight}" Text="50"/>
                                <TextBlock Style="{StaticResource TickCentre}" Text="25"/>
                            </DockPanel>

                            <UniformGrid Style="{StaticResource ButtonRow}">
                                <Button Style="{StaticResource PrimaryButton}" Content="Start" Click="OnStartClick"/>
                                <Button x:Name="PauseResume2" Style="{StaticResource DemoButton}" Content="Pause" Click="OnPauseResumeClick"/>
                            </UniformGrid>

                            <DockPanel Style="{StaticResource SectionHeader}">
