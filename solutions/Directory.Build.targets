<Project>

  <!-- Packable projects carry the repository README as their package README. This is in the
       .targets file, not the .props file, because a project sets IsPackable in its own body,
       which is evaluated after Directory.Build.props. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
