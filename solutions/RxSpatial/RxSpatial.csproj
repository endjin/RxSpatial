<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RxSpatial</RootNamespace>
    <AssemblyName>RxSpatial</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RxSpatial.Geo\RxSpatial.Geo.csproj" />
    <ProjectReference Include="..\RxSpatial.Index\RxSpatial.Index.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- RxSpatial.SqlServer runs its SQL Server facades on this assembly's engine
         (MovingObjectCore, ISpatialOperations, the backends and query observers). Granting it
         internal access keeps that engine an implementation detail: making it public would
         freeze a large generic surface (static abstract operations, backend plumbing) as
         supported API for the sake of one first-party satellite assembly. -->
    <InternalsVisibleTo Include="RxSpatial.SqlServer" />
  </ItemGroup>

</Project>
