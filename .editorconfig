root = true

[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,config,xml,xaml,resx}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# .NET style
dotnet_sort_system_directives_first = true
csharp_style_namespace_declarations = file_scoped:suggestion

# C# 14 features (endjin .NET 10 modernization specification)
csharp_style_prefer_extended_property_pattern = true
csharp_style_prefer_field_keyword = true
csharp_style_null_conditional_assignment = true

# Declarations name their type; the value uses target-typed `new` where the type is on the left.
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = false:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

# Extension members
dotnet_diagnostic.IDE0001.severity = suggestion

# Performance
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1823.severity = warning

# Rules above the Recommended analysis mode, each guarding a defect class this codebase has
# actually shipped: culture-dependent formatting (the WKT bug), a discarded IDisposable (the
# location-tracker leak), and an unqualified P/Invoke search path (the
# GetSystemTimePreciseAsFileTime clock, since replaced by Stopwatch). No P/Invoke remains;
# CA5392 stays on so that any future one names its search path.
dotnet_diagnostic.CA1305.severity = warning
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA5392.severity = warning
dotnet_diagnostic.CA1852.severity = warning

# RxGeography implements IObserver<T>, whose parameter the BCL itself names `error`. Renaming
# it to satisfy the VB keyword check would make the override diverge from the interface.
dotnet_diagnostic.CA1716.severity = none

# Test and benchmark projects are not libraries: their identifiers follow xUnit-style
# Method_Scenario naming, and BenchmarkDotNet requires [Params] to be public fields.
[solutions/*.{Tests,Benchmarks,Experiments}/**.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1051.severity = none
