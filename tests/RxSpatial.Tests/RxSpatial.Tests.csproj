<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>RxSpatial.Tests</RootNamespace>
    <AssemblyName>RxSpatial.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test-only geodesic oracle (Karney's algorithms); never a runtime dependency. -->
    <PackageReference Include="GeographicLib.NET" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RxSpatial\RxSpatial.csproj" />
    <ProjectReference Include="..\..\src\RxSpatial.Index\RxSpatial.Index.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SQL Server golden values (tests/golden), read by the fidelity tests on any OS. -->
    <None Include="..\golden\*.json" Link="golden\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
