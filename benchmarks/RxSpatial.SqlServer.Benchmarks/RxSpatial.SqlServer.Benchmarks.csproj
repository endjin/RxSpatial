    <RootNamespace>RxSpatial.SqlServer.Benchmarks</RootNamespace>
    <AssemblyName>RxSpatial.SqlServer.Benchmarks</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.SqlServer.Types" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RxSpatial\RxSpatial.csproj" />
    <ProjectReference Include="..\..\src\RxSpatial.SqlServer\RxSpatial.SqlServer.csproj" />
  </ItemGroup>

</Project>
