                            </DockPanel>
                            <TextBlock Style="{StaticResource GuidanceNote}" Margin="0,6,0,10"
                                       Text="This tab uses the List index: it needs every vehicle's distance on every update, which a spatial index would prune away."/>
                        </StackPanel>

                        <StackPanel x:Name="GuidanceNearVehicle" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource GuidanceTitle}" Text="Near vehicle – two offenders who must not meet"/>
                            <StackPanel Style="{StaticResource QueryTagRow}">
                                <Border Style="{StaticResource QueryTag}"><TextBlock Style="{StaticResource QueryTagText}" Text="RxRxDistance"/></Border>
                            </StackPanel>
                            <DockPanel Style="{StaticResource Step}">
                                <ContentControl Style="{StaticResource StepNumber}" Content="1"/>
                                <TextBlock Style="{StaticResource GuidanceText}">Press Start. This tab always replays all 20 vehicles, with Observe distance pre-set to 5,000 m <Run Style="{StaticResource Citation}">(SIGMOD 2016)</Run>.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Step}">
                                <ContentControl Style="{StaticResource StepNumber}" Content="2"/>
                                <TextBlock Style="{StaticResource GuidanceText}">Pairs 10-12 and 15-16 are watched from Start: the offenders close enough to meet in the <Run Style="{StaticResource Citation}">ICDE paper's Fig. 4c</Run>, mostly yellow.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Step}">
                                <ContentControl Style="{StaticResource StepNumber}" Content="3"/>
                                <TextBlock Style="{StaticResource GuidanceText}">To watch more pairs, pick two vehicles with the sliders and press Watch pair.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Step}">
                                <ContentControl Style="{StaticResource StepNumber}" Content="4"/>
                                <TextBlock Style="{StaticResource GuidanceText}">Watch all pairs watches all 190 pairs of vehicles: the self join of <Run Style="{StaticResource Citation}">ICDE 2017 section V.B</Run>, which continuously evaluates the distance between every pair of cars. Each vehicle then shows the most urgent colour of its 19 pairs, which is the colour for its nearest other vehicle. Gray means that no other vehicle is within the observe distance.</TextBlock>
                            </DockPanel>
                            <TextBlock Style="{StaticResource GuidanceSection}" Text="Legend"/>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatch}"><Ellipse Style="{StaticResource LegendDot}" Fill="#1565C0"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Blue circle</Run> – not watched.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatch}"><Ellipse Style="{StaticResource LegendDashedDot}"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Gray dashed ring</Run> – watched, farther apart than the observe distance.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatch}"><Rectangle Style="{StaticResource LegendSquare}"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Green rounded square</Run> – within the observe distance.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatch}"><Path Style="{StaticResource LegendTriangle}"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Yellow triangle</Run> – closer than 4/7 of it (meet-up warning).</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatch}"><Rectangle Style="{StaticResource LegendDiamond}"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Red diamond</Run> – closer than 1/7 of it: minimum safe distance (alert).</TextBlock>
                            </DockPanel>
                            <TextBlock Style="{StaticResource GuidanceNote}" Margin="0,6,0,10"
                                       Text="A vehicle in several pairs shows its most urgent colour. Clear pairs stops all watching, pre-set pairs included. List index, as on Near area."/>
                        </StackPanel>

                        <StackPanel x:Name="GuidanceConvoyLink" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource GuidanceTitle}" Text="Convoy link – vehicles sharing data while they stay in range"/>
                            <StackPanel Style="{StaticResource QueryTagRow}">
                                <Border Style="{StaticResource QueryTag}"><TextBlock Style="{StaticResource QueryTagText}" Text="RxRxDistance"/></Border>
                                <TextBlock Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="6,0,0,0" Text="with a connection line"/>
                            </StackPanel>
                            <DockPanel Style="{StaticResource Step}">
                                <ContentControl Style="{StaticResource StepNumber}" Content="1"/>
                                <TextBlock Style="{StaticResource GuidanceText}">Press Start (all 20 vehicles). Pairs 4-18, 10-12 and 7-9 are watched from Start at an Observe distance of 8,000 m, as in the <Run Style="{StaticResource Citation}">ICDE paper's Fig. 5 (DEBS 2016 Fig. 3)</Run>: 4-18 mostly gray, 10-12 mostly yellow, 7-9 mostly green.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Step}">
                                <ContentControl Style="{StaticResource StepNumber}" Content="2"/>
                                <TextBlock Style="{StaticResource GuidanceText}">To link more pairs, pick two vehicles and press Watch pair; both ends of a pair move its line.</TextBlock>
                            </DockPanel>
                            <TextBlock Style="{StaticResource GuidanceSection}" Text="Legend (marker and line)"/>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatchWide}">
                                    <Ellipse Style="{StaticResource LegendDashedDot}"/>
                                    <Line Style="{StaticResource LegendLine}" Stroke="#424242" StrokeThickness="2" StrokeDashArray="1.5 2" StrokeDashCap="Round"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Gray dashed ring, dark dotted line</Run> – watching each other, but too far apart to connect (beyond the observe distance).</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatchWide}">
                                    <Rectangle Style="{StaticResource LegendSquare}"/>
                                    <Line Style="{StaticResource LegendLine}" Stroke="#2E7D32" StrokeThickness="2" Opacity="0.8"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Green rounded square, thin solid line</Run> – connected near the limit; likely to drop if they drift apart.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatchWide}">
                                    <Path Style="{StaticResource LegendTriangle}"/>
                                    <Line Style="{StaticResource LegendLine}" Stroke="#F9A825" StrokeThickness="4" Opacity="0.9"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Yellow triangle, thick solid line</Run> – stable working distance (closer than 4/7 of the observe distance).</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatchWide}">
                                    <Rectangle Style="{StaticResource LegendDiamond}"/>
                                    <Line Style="{StaticResource LegendLine}" Stroke="#D32F2F" StrokeThickness="5"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Red diamond, thickest line</Run> – closer than 1/7 of the observe distance: the minimum safe distance is compromised.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatchWide}"><Ellipse Style="{StaticResource LegendDot}" Fill="#1565C0"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Blue circle</Run> – not watched.</TextBlock>
                            </DockPanel>
                        </StackPanel>

                        <StackPanel x:Name="GuidanceOverlap" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource GuidanceTitle}" Text="Overlap – car pooling and friends in a region"/>
                            <WrapPanel Margin="0,6,0,14">
                                <Border Style="{StaticResource QueryTag}" Margin="0,0,6,4"><TextBlock Style="{StaticResource QueryTagText}" Text="RxRxIntersect"/></Border>
                                <Border Style="{StaticResource QueryTag}" Margin="0,0,6,4"><TextBlock Style="{StaticResource QueryTagText}" Text="RxRxIntersection"/></Border>
                                <Border Style="{StaticResource QueryTag}" Margin="0,0,6,4"><TextBlock Style="{StaticResource QueryTagText}" Text="RxIntersection"/></Border>
                            </WrapPanel>
                            <DockPanel Style="{StaticResource Step}">
                                <ContentControl Style="{StaticResource StepNumber}" Content="1"/>
                                <TextBlock Style="{StaticResource GuidanceText}">Press Start (all 20 vehicles). On this tab each vehicle reports its reach – the circle of the Reach radius around it, pre-set to 2,000 m – instead of a point, so the queries compare regions.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Step}">
                                <ContentControl Style="{StaticResource StepNumber}" Content="2"/>
                                <TextBlock Style="{StaticResource GuidanceText}">Pairs 15-16, 10-12, 7-9 and 1-17 from the car pooling scenario <Run Style="{StaticResource Citation}">(DEBS 2016 section 3.3, Fig. 3)</Run> are watched from Start. RxRxIntersect turns a pair green while their reaches overlap. RxRxIntersection draws the overlap itself, the lens, with its area. Cars whose reaches overlap until they reach their destination, like 15 and 16, could car pool.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Step}">
                                <ContentControl Style="{StaticResource StepNumber}" Content="3"/>
                                <TextBlock Style="{StaticResource GuidanceText}">To watch another pair, pick two vehicles and press Watch pair. Watch all pairs watches all 190 pairs with RxRxIntersect only: every vehicle whose reach overlaps another turns green. Lenses are drawn only for the pairs you watch one at a time. Intersecting 380 pairs of regions on every update is costly, so the replay slows down.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource Step}">
                                <ContentControl Style="{StaticResource StepNumber}" Content="4"/>
                                <TextBlock Style="{StaticResource GuidanceText}">Press Add zone and drag a rectangle on the map, like "find all my friends in Seattle downtown" <Run Style="{StaticResource Citation}">(DEBS 2016 section 3.1)</Run>. RxIntersection gives each vehicle the part of its reach inside the zone, which is shaded.</TextBlock>
                            </DockPanel>
                            <TextBlock Style="{StaticResource GuidanceSection}" Text="Legend"/>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatch}"><Ellipse Style="{StaticResource LegendDot}" Fill="#1565C0"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Blue circle</Run> – not watched.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatch}"><Ellipse Style="{StaticResource LegendDashedDot}"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Gray dashed ring</Run> – watched; the reaches do not overlap.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatch}"><Rectangle Style="{StaticResource LegendSquare}"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Green rounded square</Run> – watched; the reaches overlap (could car pool).</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatch}"><Ellipse Style="{StaticResource ReachSwatch}"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Thin slate circle</Run> – a vehicle's reach.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatch}"><Path Style="{StaticResource LensSwatch}"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Teal dotted lens</Run> – where a watched pair's reaches overlap, labelled with its area.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatch}"><Rectangle Style="{StaticResource ZoneSwatch}"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Brown outline</Run> – a zone you drew.</TextBlock>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <StackPanel Style="{StaticResource LegendSwatch}"><Rectangle Style="{StaticResource ZoneOverlapSwatch}"/></StackPanel>
                                <TextBlock Style="{StaticResource GuidanceText}"><Run Style="{StaticResource Term}">Brown hatching</Run> – the part of a vehicle's reach inside a zone.</TextBlock>
                            </DockPanel>
                            <TextBlock Style="{StaticResource GuidanceNote}" Margin="0,6,0,10"
                                       Text="Clear pairs and Clear zones each remove only their own kind. List index: the queries must report when two reaches stop overlapping or a reach leaves a zone, which a spatial index would prune away."/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Status area: the live backend (set by ShowGuidance) and the reset rule. -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                    Padding="16,10,16,12">
                <StackPanel>
                    <TextBlock x:Name="BackendText" FontSize="12" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Switching tabs restores the tab's pre-set controls and pairs, and removes every area, other pair and vehicle."/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
