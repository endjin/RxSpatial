<Window x:Class="MapRunRxSpatial.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MapRun RxSpatial" Height="640" Width="1024" MinHeight="600" MinWidth="900" Loaded="OnLoaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- WebView2 is an HWND-hosted control that always renders above WPF content,
                 so the control panel sits beside the map instead of overlaying it. -->
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <wv2:WebView2 x:Name="mapView" Grid.Column="1"/>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TabControl Grid.Row="0" VerticalAlignment="Top" SelectionChanged="OnScenarioTabChanged">
            <TabItem Margin="0" Opacity="1" Background="Linen">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Background="Linen" Text="Intersect"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Background="Transparent" Margin="0,0,-3,0">
                    <Grid x:Name="Intersect" Visibility="Visible">
                        <Grid Background="Linen" Opacity="1">
                            <Border
        			MinWidth="250"
        			Background="Linen"
                    Opacity="1"
        			BorderBrush="OldLace"
        			BorderThickness="2"
        			CornerRadius="10,10,10,10"
        			HorizontalAlignment="Center"
        			VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Margin="5,15" x:Name="VehicleNum" Text=" Vehicle Number: 1" FontWeight="Bold" FontFamily="Cambria" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="164">
                                        <Slider Margin="0,5,0,0"
                        		x:Name="VehicleCountSlider"
                        		Minimum="1"
                        		Maximum="20"
                        		ValueChanged="OnVehicleCountChanged" Width="165" />
                                    </StackPanel>
                                    <TextBlock Margin="5" Text="1                        10                        20" FontWeight="Bold" FontFamily="Cambria" Width="163" />
                                    <TextBlock Margin="5" x:Name="VehicleSpeed" Text=" Vehicle Speed: 1" FontWeight="Bold" FontFamily="Cambria" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="164">
                                        <Slider Margin="0,5,0,0"
                        		x:Name="VehicleSpeedSlider"
                        		Minimum="1"
                        		Maximum="100"
                        		ValueChanged="OnVehicleSpeedChanged" Width="165" />
                                    </StackPanel>
                                    <TextBlock Margin="5" Text="1                        50                     100" FontWeight="Bold" FontFamily="Cambria" Width="160" />
                                    <Button x:Name="AddAreaButton" Margin="5" Content="Add Area" Background="{x:Null}" Click="OnAddAreaClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Width="76" />
                                    <Button x:Name="ClearAreaButton" Margin="5" Content="Clear Area" Background="{x:Null}" Click="OnClearClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Width="76" />
                                    <Button x:Name="StartButton" Margin="5" Content="Start" Background="{x:Null}" Click="OnStartClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Width="76" />
                                    <Button x:Name="PauseResume2" Height="20" Width="76" Content="Pause" Background="Linen"
                Click="OnPauseResumeClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Margin="5"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>
            </TabItem>
            <TabItem Margin="0" Background="Linen">
                <TabItem.Header>
                    <StackPanel>
                        <TextBlock Text="Dist" Background="Linen"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Background="Transparent" Margin="0,0,-3,0">
                    <Grid x:Name="Distance" Visibility="Visible">
                        <Grid Background="Transparent" Opacity="1">
                            <Border
        			MinWidth="250"
        			Background="Linen"
                    Opacity="1"
        			BorderBrush="OldLace"
        			BorderThickness="2"
        			CornerRadius="10,10,10,10"
 Margin="0">
                                <StackPanel Margin="2">
                                    <TextBlock Margin="5,30,15,0" x:Name="VehicleNum1" Text=" Vehicle Number: 1" FontWeight="Bold" FontFamily="Cambria" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="164">
                                        <Slider Margin="0,0,0,0"
                        		x:Name="VehicleCountSlider1"
                        		Minimum="1"
                        		Maximum="20"
                        		ValueChanged="OnVehicleCountChanged" Width="165" />
                                    </StackPanel>
                                    <TextBlock Margin="0,0,0,0" Text="1                        10                        20" FontWeight="Bold" FontFamily="Cambria" Width="163" />
                                    <TextBlock Margin="5" x:Name="VehicleSpeed1" Text=" Vehicle Speed: 1" FontWeight="Bold" FontFamily="Cambria" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="164">
                                        <Slider Margin="0,0,0,0"
                        		x:Name="VehicleSpeedSlider1"
                        		Minimum="1"
                        		Maximum="100"
                        		ValueChanged="OnVehicleSpeedChanged" Width="165" />
                                    </StackPanel>
                                    <TextBlock Margin="0" Text="1                        50                     100" FontWeight="Bold" FontFamily="Cambria" Width="160" />
                                    <TextBlock Margin="0,0,0,0" x:Name="ObserveDist" Text=" Observe Distance: 1" FontWeight="Bold" FontFamily="Cambria" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="164">
                                        <Slider Margin="0,0,0,0"
                        		x:Name="ObserveDistanceSlider"
                        		Minimum="1"
                        		Maximum="10000"
                        		ValueChanged="OnObserveDistanceChanged" Width="165" />
                                    </StackPanel>
                                    <TextBlock Margin="5" Text="1                        5k                     10k" FontWeight="Bold" FontFamily="Cambria" Width="162" />
                                    <Button x:Name="AddAreaButton1" Margin="3" Content="Add Area" Background="{x:Null}" Click="OnAddAreaClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Width="76" />
                                    <Button x:Name="ClearAreaButton1" Margin="3" Content="Clear Area" Background="{x:Null}" Click="OnClearClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Width="76" />
                                    <Button x:Name="StartButton1" Margin="85,3" Content="Start" Background="{x:Null}" Click="OnStartClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Width="76"/>
                                    <Button x:Name="PauseResume1" Height="20" Width="76" Content="Pause" Background="Linen"
                Click="OnPauseResumeClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Margin="3"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>
            </TabItem>
            <TabItem Margin="0,0,0,0" Background="Linen">
                <TabItem.Header>
                    <StackPanel Background="Linen">
                        <TextBlock Background="Linen" Text="RxRxDist"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Background="Transparent" Margin="0,0,-3,0">
                    <Grid x:Name="RxRxDistance" Visibility="Visible">
                        <Grid Background="Transparent" Opacity="1">
                            <Border
        			MinWidth="250"
        			Background="Linen"
                    Opacity="1"
        			BorderBrush="OldLace"
        			BorderThickness="2"
        			CornerRadius="10,10,10,10"
 Margin="0">
                                <StackPanel Margin="2">
                                    <TextBlock Margin="8,30,0,0"
            x:Name="FleetSizeText"
            Text="Moving Object Number: 20" FontWeight="Bold" FontFamily="Cambria"/>
                                    <TextBlock Margin="5" x:Name="VehicleSpeed2" Text=" Movement Speed: 1" FontWeight="Bold" FontFamily="Cambria" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="164">
                                        <Slider Margin="0,0,0,0"
                        		x:Name="VehicleSpeedSlider2"
                        		Minimum="1"
                        		Maximum="100"
                        		ValueChanged="OnVehicleSpeedChanged" Width="165" />
                                    </StackPanel>
                                    <TextBlock Margin="0" Text="1                        50                     100" FontWeight="Bold" FontFamily="Cambria" Width="160" />
                                    <TextBlock Margin="0,0,0,0" x:Name="ObserveDist1" Text=" Observe Distance: 1" FontWeight="Bold" FontFamily="Cambria" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="164">
                                        <Slider Margin="0,0,0,0"
                        		x:Name="ObserveDistanceSlider1"
                        		Minimum="1"
                        		Maximum="10000"
                        		ValueChanged="OnObserveDistanceChanged" Width="165" />
                                    </StackPanel>
                                    <TextBlock Margin="0" Text="1                        5k                     10k" FontWeight="Bold" FontFamily="Cambria" Width="162" />
                                    <TextBlock Margin="0,0,0,0" x:Name="TrackedObserverState"
                                               Text="Observer Condition:" FontWeight="Bold" FontFamily="Cambria" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="200">
                                        <Slider Margin="0,0,0,0"
                        		x:Name="TrackedPairSlider1"
                        		Minimum="0"
                        		Maximum="19"
                        		ValueChanged="OnTrackedPairChanged" Width="90" />
                                        <Slider Margin="15,0,0,0"
                        		x:Name="TrackedPairSlider2"
                        		Minimum="0"
                        		Maximum="19"
                        		ValueChanged="OnTrackedPairChanged" Width="90" />
                                    </StackPanel>
                                    <TextBlock Margin="0" Text="0                          19      0                         19" FontWeight="Bold" FontFamily="Cambria" Width="200" />
                                    <Button x:Name="AddObserverButton" Margin="5,1" Content="Add Observer" Background="{x:Null}" Click="OnAddTrackedPairClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Width="110" />
                                    <Button x:Name="ClearObserversButton" Margin="5,1" Content="Clear Observers" Background="{x:Null}" Click="OnClearClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Width="110" />
                                    <Button x:Name="StartButton2" Margin="85,1" Content="Start" Background="{x:Null}" Click="OnStartClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Width="76"/>
                                    <Button x:Name="PauseResume" Height="20" Width="76" Content="Pause" Background="Linen"
                Click="OnPauseResumeClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Margin="1"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>
            </TabItem>
            <TabItem Margin="0,0,0,0" Background="Linen">
                <TabItem.Header>
                    <StackPanel Background="Linen">
                        <TextBlock Background="Linen" Text="RxRxDistConn"/>
                    </StackPanel>
                </TabItem.Header>
                <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Horizontal" Background="Transparent" Margin="0,0,-3,0">
                    <Grid x:Name="RxRxDistanceConnection" Visibility="Visible">
                        <Grid Background="Transparent" Opacity="1">
                            <Border
        			MinWidth="250"
        			Background="Linen"
                    Opacity="1"
        			BorderBrush="OldLace"
        			BorderThickness="2"
        			CornerRadius="10,10,10,10"
 Margin="0">
                                <StackPanel Margin="2">
                                    <TextBlock Margin="8,30,0,0"
            x:Name="FleetSizeText2"
            Text="Moving Object Number: 20" FontWeight="Bold" FontFamily="Cambria"/>
                                    <TextBlock Margin="5" x:Name="VehicleSpeed3" Text=" Movement Speed: 1" FontWeight="Bold" FontFamily="Cambria" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="164">
                                        <Slider Margin="0,0,0,0"
                        		x:Name="VehicleSpeedSlider3"
                        		Minimum="1"
                        		Maximum="100"
                        		ValueChanged="OnVehicleSpeedChanged" Width="165" />
                                    </StackPanel>
                                    <TextBlock Margin="0" Text="1                        50                     100" FontWeight="Bold" FontFamily="Cambria" Width="160" />
                                    <TextBlock Margin="0,0,0,0" x:Name="ObserveDist2" Text=" Observe Distance: 1" FontWeight="Bold" FontFamily="Cambria" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="164">
                                        <Slider Margin="0,0,0,0"
                        		x:Name="ObserveDistanceSlider2"
                        		Minimum="1"
                        		Maximum="10000"
                        		ValueChanged="OnObserveDistanceChanged" Width="165" />
                                    </StackPanel>
                                    <TextBlock Margin="0" Text="1                        5k                     10k" FontWeight="Bold" FontFamily="Cambria" Width="162" />
                                    <TextBlock Margin="0,0,0,0" x:Name="ConnectionObserverState"
                                               Text="Observer Condition:" FontWeight="Bold" FontFamily="Cambria" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="200">
                                        <Slider Margin="0,0,0,0"
                        		x:Name="ConnectionPairSlider1"
                        		Minimum="0"
                        		Maximum="19"
                        		ValueChanged="OnConnectionPairChanged" Width="90" />
                                        <Slider Margin="15,0,0,0"
                        		x:Name="ConnectionPairSlider2"
                        		Minimum="0"
                        		Maximum="19"
                        		ValueChanged="OnConnectionPairChanged" Width="90" />
                                    </StackPanel>
                                    <TextBlock Margin="0" Text="0                          19      0                         19" FontWeight="Bold" FontFamily="Cambria" Width="200" />
                                    <Button x:Name="AddConnectionObserverButton" Margin="5,1" Content="Add Observer" Background="{x:Null}" Click="OnAddConnectionPairClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Width="110" />
                                    <Button x:Name="ClearObserversButton1" Margin="5,1" Content="Clear Observers" Background="{x:Null}" Click="OnClearClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Width="110" />
                                    <Button x:Name="StartButton3" Margin="85,1" Content="Start" Background="{x:Null}" Click="OnStartClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Width="76"/>
                                    <Button x:Name="PauseResume3" Height="20" Width="76" Content="Pause" Background="Linen"
                Click="OnPauseResumeClick" FontWeight="Bold" BorderThickness ="2" BorderBrush="Gray" Margin="1"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </StackPanel>
            </TabItem>
            </TabControl>

            <!-- Fills the space left under the (per-tab, variable-height) TabControl and
                 scrolls internally, so the text can never be clipped by the window edge. -->
            <Border Grid.Row="1" Background="Linen" BorderBrush="OldLace" BorderThickness="2"
                    CornerRadius="10" Margin="4,6,4,4" Padding="8,8,2,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel>
                        <TextBlock FontWeight="Bold" FontFamily="Cambria" Text="How to use" Margin="0,0,0,4"/>
                        <TextBlock TextWrapping="Wrap" FontFamily="Cambria" FontSize="11.5">
                            1. Set Vehicle Number (20 = whole fleet) and Vehicle Speed (try 25), then press Start.
                            Vehicles replay recorded Seattle trajectories - nothing moves until Start is pressed.<LineBreak/><LineBreak/>
                            2. Press Add Area, then click two corners on the map. Vehicles inside the orange
                            geofence turn red via continuous RxIntersect queries on the RUM-tree spatial index.<LineBreak/><LineBreak/>
                            3. The Dist tab colours vehicles by distance band to your areas. The RxRxDist tabs
                            track two moving vehicles against each other: pick their IDs with the twin sliders
                            and press Add Observer - their connection line changes as they approach.
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</Window>
