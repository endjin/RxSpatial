<Window x:Class="MapRunRxSpatial.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="MapRun RxSpatial" Height="880" Width="1300" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded">
    <!-- Shared styles come first: a missing StaticResource key fails when the window is
         created, not at build time. -->
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>
        <Style x:Key="Tick" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="DimGray"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="DemoButton" TargetType="Button">
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Margin" Value="0,6,6,0"/>
        </Style>
        <!-- Every slider here selects an integer, so values snap to whole numbers. -->
        <Style x:Key="DemoSlider" TargetType="Slider">
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickFrequency" Value="1"/>
        </Style>
        <Style x:Key="GuidanceHeading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="GuidanceText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="LegendRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="LegendDot" TargetType="Ellipse">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0,3,6,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>
        <Style x:Key="LegendLine" TargetType="Line">
            <Setter Property="X1" Value="0"/>
            <Setter Property="X2" Value="18"/>
            <Setter Property="Y1" Value="8"/>
            <Setter Property="Y2" Value="8"/>
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="DockPanel.Dock" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- WebView2 is an HWND-hosted control that always renders above WPF content,
                 so the control panel sits beside the map instead of overlaying it. -->
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <wv2:WebView2 x:Name="mapView" Grid.Column="1"/>

        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Keep the tab order: OnScenarioTabChanged maps tabs to scenarios by index. -->
            <TabControl Grid.Row="0" VerticalAlignment="Top" SelectionChanged="OnScenarioTabChanged">
                <TabItem Header="Geofence">
                    <StackPanel Margin="6">
                        <TextBlock Style="{StaticResource SectionLabel}"
                                   Text="{Binding Value, ElementName=VehicleCountSlider, StringFormat='Vehicles: {0:0}'}"/>
                        <Slider x:Name="VehicleCountSlider" Style="{StaticResource DemoSlider}"
                                Minimum="1" Maximum="20" ValueChanged="OnVehicleCountChanged"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="1"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="20"/>
                            <TextBlock Style="{StaticResource Tick}" HorizontalAlignment="Center" Text="10"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionLabel}"
                                   Text="{Binding Value, ElementName=VehicleSpeedSlider, StringFormat='Replay rate: {0:0} updates/s'}"/>
                        <Slider x:Name="VehicleSpeedSlider" Style="{StaticResource DemoSlider}"
                                Minimum="1" Maximum="50" ValueChanged="OnVehicleSpeedChanged"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="1"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="50"/>
                            <TextBlock Style="{StaticResource Tick}" HorizontalAlignment="Center" Text="25"/>
                        </DockPanel>

                        <WrapPanel>
                            <Button Style="{StaticResource DemoButton}" Content="Start" Click="OnStartClick"/>
                            <Button x:Name="PauseResume2" Style="{StaticResource DemoButton}" Content="Pause" Click="OnPauseResumeClick"/>
                            <Button Style="{StaticResource DemoButton}" Content="Clear areas" Click="OnClearClick"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="Add:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,6,6,0"/>
                            <Button Style="{StaticResource DemoButton}" Content="Restricted area" Click="OnAddAreaClick"/>
                            <Button Style="{StaticResource DemoButton}" Content="Confinement area" Click="OnAddConfinementAreaClick"/>
                        </WrapPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Near area">
                    <StackPanel Margin="6">
                        <TextBlock Style="{StaticResource SectionLabel}"
                                   Text="{Binding Value, ElementName=VehicleCountSlider1, StringFormat='Vehicles: {0:0}'}"/>
                        <Slider x:Name="VehicleCountSlider1" Style="{StaticResource DemoSlider}"
                                Minimum="1" Maximum="20" ValueChanged="OnVehicleCountChanged"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="1"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="20"/>
                            <TextBlock Style="{StaticResource Tick}" HorizontalAlignment="Center" Text="10"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionLabel}"
                                   Text="{Binding Value, ElementName=VehicleSpeedSlider1, StringFormat='Replay rate: {0:0} updates/s'}"/>
                        <Slider x:Name="VehicleSpeedSlider1" Style="{StaticResource DemoSlider}"
                                Minimum="1" Maximum="50" ValueChanged="OnVehicleSpeedChanged"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="1"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="50"/>
                            <TextBlock Style="{StaticResource Tick}" HorizontalAlignment="Center" Text="25"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionLabel}"
                                   Text="{Binding Value, ElementName=ObserveDistanceSlider, StringFormat='Observe distance: {0:N0} m'}"/>
                        <Slider x:Name="ObserveDistanceSlider" Style="{StaticResource DemoSlider}"
                                Minimum="1" Maximum="10000" ValueChanged="OnObserveDistanceChanged"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="1 m"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="10 km"/>
                            <TextBlock Style="{StaticResource Tick}" HorizontalAlignment="Center" Text="5 km"/>
                        </DockPanel>

                        <WrapPanel>
                            <Button Style="{StaticResource DemoButton}" Content="Start" Click="OnStartClick"/>
                            <Button x:Name="PauseResume1" Style="{StaticResource DemoButton}" Content="Pause" Click="OnPauseResumeClick"/>
                            <Button Style="{StaticResource DemoButton}" Content="Add area" Click="OnAddAreaClick"/>
                            <Button Style="{StaticResource DemoButton}" Content="Clear areas" Click="OnClearClick"/>
                        </WrapPanel>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Near vehicle">
                    <StackPanel Margin="6">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Vehicles: all 20"/>

                        <TextBlock Style="{StaticResource SectionLabel}"
                                   Text="{Binding Value, ElementName=VehicleSpeedSlider2, StringFormat='Replay rate: {0:0} updates/s'}"/>
                        <Slider x:Name="VehicleSpeedSlider2" Style="{StaticResource DemoSlider}"
                                Minimum="1" Maximum="50" ValueChanged="OnVehicleSpeedChanged"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="1"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="50"/>
                            <TextBlock Style="{StaticResource Tick}" HorizontalAlignment="Center" Text="25"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionLabel}"
                                   Text="{Binding Value, ElementName=ObserveDistanceSlider1, StringFormat='Observe distance: {0:N0} m'}"/>
                        <Slider x:Name="ObserveDistanceSlider1" Style="{StaticResource DemoSlider}"
                                Minimum="1" Maximum="10000" ValueChanged="OnObserveDistanceChanged"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="1 m"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="10 km"/>
                            <TextBlock Style="{StaticResource Tick}" HorizontalAlignment="Center" Text="5 km"/>
                        </DockPanel>

                        <!-- The pair sliders sit side by side (as in the 2016 panel) so the
                             guidance below keeps room for the whole legend. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionLabel}"
                                           Text="{Binding Value, ElementName=TrackedPairSlider1, StringFormat='First vehicle: {0:0}'}"/>
                                <Slider x:Name="TrackedPairSlider1" Style="{StaticResource DemoSlider}" Minimum="0" Maximum="19"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="0"/>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="19"/>
                                    <TextBlock Style="{StaticResource Tick}"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SectionLabel}"
                                           Text="{Binding Value, ElementName=TrackedPairSlider2, StringFormat='Second vehicle: {0:0}'}"/>
                                <Slider x:Name="TrackedPairSlider2" Style="{StaticResource DemoSlider}" Minimum="0" Maximum="19"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="0"/>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="19"/>
                                    <TextBlock Style="{StaticResource Tick}"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <WrapPanel>
                            <Button Style="{StaticResource DemoButton}" Content="Start" Click="OnStartClick"/>
                            <Button x:Name="PauseResume" Style="{StaticResource DemoButton}" Content="Pause" Click="OnPauseResumeClick"/>
                            <Button Style="{StaticResource DemoButton}" Content="Watch pair" Click="OnWatchPairClick"/>
                            <Button Style="{StaticResource DemoButton}" Content="Watch all pairs" Click="OnWatchAllPairsClick"/>
                            <Button Style="{StaticResource DemoButton}" Content="Clear pairs" Click="OnClearClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="TrackedPairStatus" Style="{StaticResource GuidanceText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Convoy link">
                    <StackPanel Margin="6">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="Vehicles: all 20"/>

                        <TextBlock Style="{StaticResource SectionLabel}"
                                   Text="{Binding Value, ElementName=VehicleSpeedSlider3, StringFormat='Replay rate: {0:0} updates/s'}"/>
                        <Slider x:Name="VehicleSpeedSlider3" Style="{StaticResource DemoSlider}"
                                Minimum="1" Maximum="50" ValueChanged="OnVehicleSpeedChanged"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="1"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="50"/>
                            <TextBlock Style="{StaticResource Tick}" HorizontalAlignment="Center" Text="25"/>
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionLabel}"
                                   Text="{Binding Value, ElementName=ObserveDistanceSlider2, StringFormat='Observe distance: {0:N0} m'}"/>
                        <Slider x:Name="ObserveDistanceSlider2" Style="{StaticResource DemoSlider}"
                                Minimum="1" Maximum="10000" ValueChanged="OnObserveDistanceChanged"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="1 m"/>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="10 km"/>
                            <TextBlock Style="{StaticResource Tick}" HorizontalAlignment="Center" Text="5 km"/>
                        </DockPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource SectionLabel}"
                                           Text="{Binding Value, ElementName=ConnectionPairSlider1, StringFormat='First vehicle: {0:0}'}"/>
                                <Slider x:Name="ConnectionPairSlider1" Style="{StaticResource DemoSlider}" Minimum="0" Maximum="19"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="0"/>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="19"/>
                                    <TextBlock Style="{StaticResource Tick}"/>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SectionLabel}"
                                           Text="{Binding Value, ElementName=ConnectionPairSlider2, StringFormat='Second vehicle: {0:0}'}"/>
                                <Slider x:Name="ConnectionPairSlider2" Style="{StaticResource DemoSlider}" Minimum="0" Maximum="19"/>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Tick}" Text="0"/>
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Tick}" Text="19"/>
                                    <TextBlock Style="{StaticResource Tick}"/>
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <WrapPanel>
                            <Button Style="{StaticResource DemoButton}" Content="Start" Click="OnStartClick"/>
                            <Button x:Name="PauseResume3" Style="{StaticResource DemoButton}" Content="Pause" Click="OnPauseResumeClick"/>
                            <Button Style="{StaticResource DemoButton}" Content="Watch pair" Click="OnWatchPairClick"/>
                            <Button Style="{StaticResource DemoButton}" Content="Clear pairs" Click="OnClearClick"/>
                        </WrapPanel>
                        <TextBlock x:Name="ConnectionPairStatus" Style="{StaticResource GuidanceText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Fills the space left under the (per-tab, variable-height) TabControl and
                 scrolls internally, so the text can never be clipped by the window edge.
                 Only the active tab's guidance is Visible; the others are Collapsed. -->
            <Border Grid.Row="1" Background="Linen" BorderBrush="OldLace" BorderThickness="2"
                    CornerRadius="10" Margin="4,6,4,4" Padding="8,8,2,8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0" FontSize="11.5">
                    <StackPanel>
                        <StackPanel x:Name="GuidanceGeofence">
                            <TextBlock Style="{StaticResource GuidanceHeading}"
                                       Text="Geofence - restricted and confinement zones (RxIntersect)"/>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="1. Press Start. All 20 vehicles (numbered 0-19) replay recorded Seattle GPS trajectories at 25 updates/s, as in the DEBS 2016 Fig. 5 set-up; nothing moves until you press Start."/>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="2. Press Add: Restricted area or Add: Confinement area and click two corners on the map. Every vehicle gets a continuous RxIntersect query against each area."/>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="An offender must stay out of every restricted zone and inside a confinement zone, such as a city or county (ICDE 2017 Fig. 4a); a child must not leave a designated region (DEBS 2016 section 3.4). Being inside any one confinement area is enough."/>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Legend"/>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Rectangle Width="10" Height="10" Margin="0,3,6,0" VerticalAlignment="Top" DockPanel.Dock="Left"
                                           Fill="#66FFA500" Stroke="Orange" StrokeThickness="1.5"/>
                                <TextBlock TextWrapping="Wrap" Text="Orange area - restricted: a vehicle inside it turns red."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Rectangle Width="10" Height="10" Margin="0,3,6,0" VerticalAlignment="Top" DockPanel.Dock="Left"
                                           Fill="#33CE93D8" Stroke="#6A1B9A" StrokeThickness="1.5" StrokeDashArray="2 1"/>
                                <TextBlock TextWrapping="Wrap" Text="Purple dashed area - confinement: a vehicle outside every confinement area turns red."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#1565C0"/>
                                <TextBlock TextWrapping="Wrap" Text="Blue - no alert."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#D32F2F"/>
                                <TextBlock TextWrapping="Wrap" Text="Red - inside a restricted area or outside every confinement area (alert)."/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource GuidanceText}" Text="Clear areas removes every area and its queries."/>
                        </StackPanel>

                        <StackPanel x:Name="GuidanceNearArea" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource GuidanceHeading}"
                                       Text="Near area - an offender approaches a restricted zone (RxDistance)"/>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="1. Press Start, then Add area and click two corners on the map."/>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="2. Observe distance is pre-set to 4,600 m, the family-locator set-up of DEBS 2016 Fig. 4. Move it to widen or narrow the bands."/>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Legend"/>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#1565C0"/>
                                <TextBlock TextWrapping="Wrap" Text="Blue - farther than the observe distance."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#2E7D32"/>
                                <TextBlock TextWrapping="Wrap" Text="Green - within the observe distance (watching)."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#FFD54F" Stroke="#333333" StrokeThickness="1"/>
                                <TextBlock TextWrapping="Wrap" Text="Yellow - closer than 4/7 of it (warning)."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#D32F2F"/>
                                <TextBlock TextWrapping="Wrap" Text="Red - inside the area (alert)."/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="This tab uses the List index: it needs every vehicle's distance on every update, which a spatial index would prune away."/>
                        </StackPanel>

                        <StackPanel x:Name="GuidanceNearVehicle" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource GuidanceHeading}"
                                       Text="Near vehicle - two offenders who must not meet (RxRxDistance)"/>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="1. Press Start. This tab always replays all 20 vehicles, with Observe distance pre-set to 5,000 m (SIGMOD 2016)."/>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="2. Pairs 10-12 and 15-16 are watched from Start: the offenders close enough to meet in the ICDE paper's Fig. 4c, mostly yellow."/>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="3. To watch more pairs, pick two vehicles with the sliders and press Watch pair."/>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="4. Watch all pairs watches all 190 pairs of vehicles: the self join of ICDE 2017 section V.B, which continuously evaluates the distance between every pair of cars. Each vehicle then shows the most urgent colour of its 19 pairs, which is the colour for its nearest other vehicle. Gray means that no other vehicle is within the observe distance."/>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Legend"/>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#1565C0"/>
                                <TextBlock TextWrapping="Wrap" Text="Blue - not watched."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#757575"/>
                                <TextBlock TextWrapping="Wrap" Text="Gray - watched, farther apart than the observe distance."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#2E7D32"/>
                                <TextBlock TextWrapping="Wrap" Text="Green - within the observe distance."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#FFD54F" Stroke="#333333" StrokeThickness="1"/>
                                <TextBlock TextWrapping="Wrap" Text="Yellow - closer than 4/7 of it (meet-up warning)."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#D32F2F"/>
                                <TextBlock TextWrapping="Wrap" Text="Red - closer than 1/7 of it: minimum safe distance (alert)."/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="A vehicle in several pairs shows its most urgent colour. Clear pairs stops all watching, pre-set pairs included. List index, as on Near area."/>
                        </StackPanel>

                        <StackPanel x:Name="GuidanceConvoyLink" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource GuidanceHeading}"
                                       Text="Convoy link - vehicles sharing data while they stay in range (RxRxDistance with a connection line)"/>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="1. Press Start (all 20 vehicles). Pairs 4-18, 10-12 and 7-9 are watched from Start at an Observe distance of 8,000 m, as in the ICDE paper's Fig. 5 (DEBS 2016 Fig. 3): 4-18 mostly gray, 10-12 mostly yellow, 7-9 mostly green."/>
                            <TextBlock Style="{StaticResource GuidanceText}"
                                       Text="2. To link more pairs, pick two vehicles and press Watch pair; both ends of a pair move its line."/>
                            <TextBlock Style="{StaticResource SectionLabel}" Text="Legend (marker and line)"/>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#757575"/>
                                <Line Style="{StaticResource LegendLine}" Stroke="#424242" StrokeThickness="2" StrokeDashArray="2 3"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="Gray marker, dark dotted line - watching each other, but too far apart to connect (beyond the observe distance)."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#2E7D32"/>
                                <Line Style="{StaticResource LegendLine}" Stroke="#2E7D32" StrokeThickness="2" Opacity="0.8"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="Green marker, thin solid line - connected near the limit; likely to drop if they drift apart."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#FFD54F" Stroke="#333333" StrokeThickness="1"/>
                                <Line Style="{StaticResource LegendLine}" Stroke="#F9A825" StrokeThickness="4" Opacity="0.9"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="Yellow marker, thick solid line - stable working distance (closer than 4/7 of the observe distance)."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#D32F2F"/>
                                <Line Style="{StaticResource LegendLine}" Stroke="#D32F2F" StrokeThickness="5"/>
                                <TextBlock TextWrapping="Wrap"
                                           Text="Red marker, thickest line - closer than 1/7 of the observe distance: the minimum safe distance is compromised."/>
                            </DockPanel>
                            <DockPanel Style="{StaticResource LegendRow}">
                                <Ellipse Style="{StaticResource LegendDot}" Fill="#1565C0"/>
                                <TextBlock TextWrapping="Wrap" Text="Blue - not watched."/>
                            </DockPanel>
                        </StackPanel>

                        <!-- Shared footer: the live backend (set by ShowGuidance) and the reset rule. -->
                        <TextBlock x:Name="BackendText" Style="{StaticResource SectionLabel}" TextWrapping="Wrap"/>
                        <TextBlock Style="{StaticResource GuidanceText}"
                                   Text="Switching tabs restores the tab's pre-set controls and pairs, and removes every area, other pair and vehicle."/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</Window>
