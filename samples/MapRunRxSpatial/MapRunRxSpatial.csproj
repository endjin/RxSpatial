<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>MapRunRxSpatial</RootNamespace>
    <AssemblyName>MapRunRxSpatial</AssemblyName>
    <!-- 2016-era demo sources are kept close to their original style. -->
    <Nullable>disable</Nullable>
    <!-- Microsoft.Maps.MapControl.WPF is a .NET Framework assembly consumed via
         AssetTargetFallback; NU1701 is expected and accepted. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maps.MapControl.WPF" />
    <PackageReference Include="Microsoft.SqlServer.Types" />
    <!-- System.Configuration.ConfigurationManager comes from the WindowsDesktop
         shared framework on net10.0-windows. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RxSpatial\RxSpatial.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="trafficData\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
